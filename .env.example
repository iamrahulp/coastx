# Public site origin. Leave blank locally; Vercel supplies its production domain automatically.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Public Supabase project values. These are safe to expose when Supabase RLS is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never add the NEXT_PUBLIC_ prefix or place this value in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay values are unused by the current demo checkout. Keep private if configured later.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional providers. Map tokens are public; weather keys must remain server-only.
NEXT_PUBLIC_MAPBOX_TOKEN=
WEATHER_API_KEY=

# Demo-only behavior. This is not authentication and must not be used for real bookings.
COASTX_DEMO_MODE=true